modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
TWILIO_WEBHOOK_BASE_URL = "https://f4a4155c-2926-4faf-b4db-4fa352c8f96c-00-1a789vjagxie3.spock.replit.dev"

[userenv.production]
TWILIO_WEBHOOK_BASE_URL = "https://contact-filter-pro--abatasi.replit.app"
